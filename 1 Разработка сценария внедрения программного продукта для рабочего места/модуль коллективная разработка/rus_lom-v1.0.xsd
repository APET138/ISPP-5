<xs:schema targetNamespace="http://ltsc.ieee.org/xsd/LOM" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:rlv="http://spec.edu.ru/xsd/RUS_LOM/Vocab" xmlns:rl="http://spec.edu.ru/xsd/RUS_LOM" xmlns:ag="http://ltsc.ieee.org/xsd/LOM/unique" xmlns="http://ltsc.ieee.org/xsd/LOM" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.0">
	<xs:include schemaLocation="lom-types.xsd"/>
	<xs:include schemaLocation="lom-vocabs.xsd"/>
	<xs:include schemaLocation="lom-vocabs-extended.xsd"/>
	<xs:import namespace="http://ltsc.ieee.org/xsd/LOM/unique" schemaLocation="lom-unique.xsd"/>
	<xs:import namespace="http://spec.edu.ru/xsd/RUS_LOM" schemaLocation="rus_lom-elements.xsd"/>
	<xs:element name="lom">
		<xs:annotation>
			<xs:documentation>Корневой элемент LOM</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="general">
					<xs:annotation>
						<xs:documentation>1. Общие сведения об ИР.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element name="identifier" type="Identifier">
								<xs:annotation>
									<xs:documentation>1.1. Глобальное уникальное обозначение ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:unique name="identifierUnique">
									<xs:selector xpath="*"/>
									<xs:field xpath="@uniqueElementName"/>
								</xs:unique>
							</xs:element>
							<xs:element name="title">
								<xs:annotation>
									<xs:documentation>1.2. Заглавие ИР.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="LanguageString">
											<xs:attributeGroup ref="ag:title"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="language">
								<xs:annotation>
									<xs:documentation>1.3. Язык ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="CharacterString">
											<xs:attributeGroup ref="customAttributes"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="description">
								<xs:annotation>
									<xs:documentation>1.4. Описание ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="LanguageString"/>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="keyword">
								<xs:annotation>
									<xs:documentation>1.5. Ключевое слово.Ключевое слово или фраза, характеризующие ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="LanguageString"/>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="coverage">
								<xs:annotation>
									<xs:documentation>1.6. Пространственный и временной охват содержимого ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="LanguageString"/>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="structure">
								<xs:annotation>
									<xs:documentation>1.7. Структура, образуемая отношениями между компонентами ИР.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="StructureVocab">
											<xs:attributeGroup ref="ag:structure"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
								<xs:unique name="structureUnique">
									<xs:selector xpath="*"/>
									<xs:field xpath="@uniqueElementName"/>
								</xs:unique>
							</xs:element>
							<xs:element name="aggregationLevel">
								<xs:annotation>
									<xs:documentation>1.8. Уровень агрегации ИР.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="AggregationLevelVocab">
											<xs:attributeGroup ref="ag:aggregationLevel"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
								<xs:unique name="aggregationLevelUnique">
									<xs:selector xpath="*"/>
									<xs:field xpath="@uniqueElementName"/>
								</xs:unique>
							</xs:element>
							<xs:element ref="rl:service">
								<xs:annotation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
									<xs:documentation>1.e1. Услуги, оказываемые на базе ИР.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:formalSpan">
								<xs:annotation>
									<xs:documentation>1.e2. Формальное представление временного охвата содержимого ИР.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
						<xs:attributeGroup ref="ag:general"/>
						<xs:attributeGroup ref="customAttributes"/>
					</xs:complexType>
					<xs:unique name="generalUnique">
						<xs:selector xpath="*"/>
						<xs:field xpath="@uniqueElementName"/>
					</xs:unique>
				</xs:element>
				<xs:element name="lifeCycle">
					<xs:annotation>
						<xs:documentation>2. Жизненный цикл ИР.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element name="version">
								<xs:annotation>
									<xs:documentation>2.1. Версия ИР.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="LanguageString">
											<xs:attributeGroup ref="ag:version"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="status">
								<xs:annotation>
									<xs:documentation>2.2. Статус ИР.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="StatusVocab">
											<xs:attributeGroup ref="ag:status"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="contribute">
								<xs:annotation>
									<xs:documentation>2.3. Информация о субъектах, внесших вклад в создание и развитие ИР, а также обеспечение его текущего состояния. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:choice minOccurs="0" maxOccurs="unbounded">
										<xs:element name="role">
											<xs:annotation>
												<xs:documentation>2.3.1. Вид вклада в ИР.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:complexContent>
													<xs:extension base="RoleVocabCommon">
														<xs:attributeGroup ref="ag:role"/>
														<xs:attributeGroup ref="customAttributes"/>
													</xs:extension>
												</xs:complexContent>
											</xs:complexType>
										</xs:element>
										<xs:element name="entity" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>2.3.2. Субъект, внесший вклад в ИР.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:simpleContent>
													<xs:extension base="VCard">
														<xs:attributeGroup ref="customAttributes"/>
													</xs:extension>
												</xs:simpleContent>
											</xs:complexType>
										</xs:element>
										<xs:element name="date">
											<xs:annotation>
												<xs:documentation>2.3.3. Дата вклада.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:complexContent>
													<xs:extension base="DateTime">
														<xs:attributeGroup ref="ag:date"/>
														<xs:attributeGroup ref="customAttributes"/>
													</xs:extension>
												</xs:complexContent>
											</xs:complexType>
										</xs:element>
										<xs:group ref="customElements"/>
									</xs:choice>
									<xs:attributeGroup ref="customAttributes"/>
								</xs:complexType>
								<xs:unique name="contributeUnique">
									<xs:selector xpath="*"/>
									<xs:field xpath="@uniqueElementName"/>
								</xs:unique>
							</xs:element>
							<xs:element ref="rl:periodOfUpdating">
								<xs:annotation>
									<xs:documentation>2.e1. Период обновления ИР.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:lastUpdating">
								<xs:annotation>
									<xs:documentation>2.e2. Дата последнего обновления ИР.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:placeOfPublication">
								<xs:annotation>
									<xs:documentation>2.e3. Место издания.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:sourceOfPublication">
								<xs:annotation>
									<xs:documentation>2.e4. Источник публикации.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:volume">
								<xs:annotation>
									<xs:documentation>2.e5. Том.Номер тома сериального или многотомного издания, соответствующего ИР.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:number">
								<xs:annotation>
									<xs:documentation>2.e6. Номер (выпуск).</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:demo">
								<xs:annotation>
									<xs:documentation>2.e7. Демо-версия (иллюстрация основных возможностей) ИР.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
						<xs:attributeGroup ref="ag:lifeCycle"/>
						<xs:attributeGroup ref="customAttributes"/>
					</xs:complexType>
					<xs:unique name="lifeCycleUnique">
						<xs:selector xpath="*"/>
						<xs:field xpath="@uniqueElementName"/>
					</xs:unique>
				</xs:element>
				<xs:element name="metaMetadata">
					<xs:annotation>
						<xs:documentation>3. Метаметаданные.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element name="identifier">
								<xs:annotation>
									<xs:documentation>3.1. Глобальное уникальное обозначение описания ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="Identifier"/>
									</xs:complexContent>
								</xs:complexType>
								<xs:unique name="meta.identifierUnique">
									<xs:selector xpath="*"/>
									<xs:field xpath="@uniqueElementName"/>
								</xs:unique>
							</xs:element>
							<xs:element name="contribute">
								<xs:annotation>
									<xs:documentation>3.2. Контейнер, содержащий элементы, которые представляют информацию о субъектах, внесших вклад в создание и обеспечение текущего состояния описания ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:choice minOccurs="0" maxOccurs="unbounded">
										<xs:element name="role">
											<xs:annotation>
												<xs:documentation>3.2.1. Вид вклада в описание ИР.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:complexContent>
													<xs:extension base="RoleMetaVocab">
														<xs:attributeGroup ref="ag:role"/>
														<xs:attributeGroup ref="customAttributes"/>
													</xs:extension>
												</xs:complexContent>
											</xs:complexType>
										</xs:element>
										<xs:element name="entity" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>3.2.2. Субъект, внесший вклад в описание ИР.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:simpleContent>
													<xs:extension base="VCard">
														<xs:attributeGroup ref="customAttributes"/>
													</xs:extension>
												</xs:simpleContent>
											</xs:complexType>
										</xs:element>
										<xs:element name="date">
											<xs:annotation>
												<xs:documentation>3.2.3. Дата вклада.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:complexContent>
													<xs:extension base="DateTime">
														<xs:attributeGroup ref="ag:date"/>
														<xs:attributeGroup ref="customAttributes"/>
													</xs:extension>
												</xs:complexContent>
											</xs:complexType>
										</xs:element>
										<xs:group ref="customElements"/>
									</xs:choice>
									<xs:attributeGroup ref="customAttributes"/>
								</xs:complexType>
								<xs:unique name="meta.contributeUnique">
									<xs:selector xpath="*"/>
									<xs:field xpath="@uniqueElementName"/>
								</xs:unique>
							</xs:element>
							<xs:element name="metadataScheme">
								<xs:annotation>
									<xs:documentation>3.3. Схема метаданных. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="CharacterString">
											<xs:attributeGroup ref="customAttributes"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="language">
								<xs:annotation>
									<xs:documentation>3.4. Язык описания ИР.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="CharacterString">
											<xs:attributeGroup ref="ag:language"/>
											<xs:attributeGroup ref="customAttributes"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:group ref="customElements"/>
						</xs:choice>
						<xs:attributeGroup ref="ag:metaMetadata"/>
						<xs:attributeGroup ref="customAttributes"/>
					</xs:complexType>
					<xs:unique name="metaMetadataUniqie">
						<xs:selector xpath="*"/>
						<xs:field xpath="@uniqueElementName"/>
					</xs:unique>
				</xs:element>
				<xs:element name="technical">
					<xs:annotation>
						<xs:documentation>4. Технические характеристики ИР.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element name="format">
								<xs:annotation>
									<xs:documentation>4.1. Тип данных, используемых в ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="CharacterString">
											<xs:attributeGroup ref="customAttributes"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="size">
								<xs:annotation>
									<xs:documentation>4.2. Объем цифрового ИР.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:positiveInteger">
											<xs:attributeGroup ref="ag:size"/>
											<xs:attributeGroup ref="customAttributes"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="location">
								<xs:annotation>
									<xs:documentation>4.3. Доступ к ИР. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="CharacterString">
											<xs:attributeGroup ref="customAttributes"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="requirement">
								<xs:annotation>
									<xs:documentation>4.4. Технические требования. (+)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence minOccurs="0">
										<xs:element name="orComposite" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>4.4.1. Альтернативное техническое требование.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:choice minOccurs="0" maxOccurs="unbounded">
													<xs:sequence>
														<xs:element name="type">
															<xs:annotation>
																<xs:documentation>4.4.1.1. Тип технологии или программной среды, требуемой для использования компьютерного ИР.</xs:documentation>
															</xs:annotation>
															<xs:complexType>
																<xs:complexContent>
																	<xs:extension base="TypeVocabCommon">
																		<xs:attributeGroup ref="ag:type"/>
																		<xs:attributeGroup ref="customAttributes"/>
																	</xs:extension>
																</xs:complexContent>
															</xs:complexType>
														</xs:element>
														<xs:element name="name">
															<xs:annotation>
																<xs:documentation>4.4.1.2. Название технологии или программной среды.</xs:documentation>
															</xs:annotation>
															<xs:complexType>
																<xs:complexContent>
																	<xs:extension base="NameVocabCommon">
																		<xs:attributeGroup ref="ag:name"/>
																		<xs:attributeGroup ref="customAttributes"/>
																	</xs:extension>
																</xs:complexContent>
															</xs:complexType>
														</xs:element>
													</xs:sequence>
													<xs:element name="minimumVersion">
														<xs:annotation>
															<xs:documentation>4.4.1.3. Низшая (минимальная) версия технологии или программной среды, позволяющая использовать ИР.</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:simpleContent>
																<xs:extension base="CharacterString">
																	<xs:attributeGroup ref="ag:minimumVersion"/>
																	<xs:attributeGroup ref="customAttributes"/>
																</xs:extension>
															</xs:simpleContent>
														</xs:complexType>
													</xs:element>
													<xs:element name="maximumVersion">
														<xs:annotation>
															<xs:documentation>4.4.1.4. Высшая (максимальная) версия технологии или программной среды, позволяющая использовать ИР.</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:simpleContent>
																<xs:extension base="CharacterString">
																	<xs:attributeGroup ref="ag:maximumVersion"/>
																	<xs:attributeGroup ref="customAttributes"/>
																</xs:extension>
															</xs:simpleContent>
														</xs:complexType>
													</xs:element>
													<xs:group ref="customElements"/>
												</xs:choice>
												<xs:attributeGroup ref="customAttributes"/>
											</xs:complexType>
											<xs:unique name="orCompositeUnique">
												<xs:selector xpath="*"/>
												<xs:field xpath="@uniqueElementName"/>
											</xs:unique>
										</xs:element>
									</xs:sequence>
									<xs:attributeGroup ref="customAttributes"/>
								</xs:complexType>
							</xs:element>
							<xs:element name="installationRemarks">
								<xs:annotation>
									<xs:documentation>4.5. Порядок инсталляции.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="LanguageString">
											<xs:attributeGroup ref="ag:installationRemarks"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="otherPlatformRequirements">
								<xs:annotation>
									<xs:documentation>4.6. Прочие технические требования.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="LanguageString">
											<xs:attributeGroup ref="ag:otherPlatformRequirements"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="duration">
								<xs:annotation>
									<xs:documentation>4.7. Длительность воспроизведения.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="Duration">
											<xs:attributeGroup ref="ag:duration"/>
											<xs:attributeGroup ref="customAttributes"/>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element ref="rl:charset">
								<xs:annotation>
									<xs:documentation>4.e1. Набор символов.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:numberOfDocuments">
