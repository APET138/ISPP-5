									<xs:documentation>4.e2. Число документов.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="rl:medium">
								<xs:annotation>
									<xs:documentation>4.e3. Данные о носителе информации.</xs:documentation>
								</xs:annotation>
							</xs:element>
