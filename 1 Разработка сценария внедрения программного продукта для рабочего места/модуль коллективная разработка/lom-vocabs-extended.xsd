			</xs:element>
			<xs:group ref="customElements"/>
		</xs:choice>
		<xs:anyAttribute namespace="##other"/>
	</xs:complexType>
	<xs:complexType name="KindVocabCommon">
		<xs:annotation>
			<xs:documentation> 7.1 Kind combined vocabulary</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="source" type="SourceValueCommon"/>
			<xs:element name="value">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="KindValuesCommon">
							<xs:attribute name="uniqueElementName" fixed="value"/>
