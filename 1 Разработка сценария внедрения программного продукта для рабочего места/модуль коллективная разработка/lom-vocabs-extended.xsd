				</xs:complexType>
			</xs:element>
			<xs:group ref="customElements"/>
		</xs:choice>
		<xs:anyAttribute namespace="##other"/>
	</xs:complexType>
	<xs:complexType name="IntendedEndUserRoleVocabCommon">
		<xs:annotation>
			<xs:documentation>5.5 IntendedEndUserRole combined vocabulary</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0" maxOccurs="unbounded">
